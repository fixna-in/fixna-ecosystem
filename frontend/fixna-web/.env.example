# Public Fixna website settings
NEXT_PUBLIC_SITE_URL=https://fixna.in

# --- Contact form (POST /api/contact) ---
# Google service-account credentials as a single-line JSON string.
# Create a service account in Google Cloud (enable the Sheets API), download the
# JSON key, and paste its contents here (or set it in Vercel env vars).
# Share the target spreadsheet with the service account's email as Editor.
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_SHEET_ID=

# Optional abuse-protection tuning (defaults shown).
CONTACT_RATE_LIMIT_PER_IP=3
CONTACT_RATE_WINDOW_MS=600000

