# Frontend environment — copy to .env.local for local values.
# ONLY NEXT_PUBLIC_* values are exposed to the browser.
#
# Local:
# NEXT_PUBLIC_API_BASE_URL=http://localhost:8080/api
# NEXT_PUBLIC_APP_ENV=local
#
# Development:
NEXT_PUBLIC_API_BASE_URL=https://localboost-api.dev.fixna.in/api
NEXT_PUBLIC_APP_ENV=dev
#
# Production:
# # NEXT_PUBLIC_API_BASE_URL=https://localboost-api.fixna.in/api
# # NEXT_PUBLIC_APP_ENV=prod

