# Fixna Ecosystem — environment template
# Copy per-product sections to service .env or app .env.local files. Never commit secrets.

# ── Local development infrastructure ─────────────────────────────────────────
# Docker Compose provides local Postgres instances
# POSTGRES_PASSWORD set at container runtime; never commit

# ── Development environment ─────────────────────────────────────────────────
# Set SPRING_PROFILES_ACTIVE=dev for local development with shared infra
# All credentials come from environment variables or Docker secrets

# ── Production environment ─────────────────────────────────────────────────
# SPRING_PROFILES_ACTIVE=prod for production deployments on Render/Vercel

# ── Consulting API ──────────────────────────────────────────────────────────
# Local development
# SPRING_PROFILES_ACTIVE=dev
# POSTGRES_PASSWORD=dev-password
# FIXNA_JWT_SECRET=dev-jwt-secret
# FIXNA_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# SPRING_DATASOURCE_URL=postgresql://consulting_user:${POSTGRES_PASSWORD}@localhost:5432/consulting_db

# Production
# SPRING_PROFILES_ACTIVE=prod
# POSTGRES_PASSWORD=prod-consulting-db-password
# FIXNA_JWT_SECRET=prod-jwt-secret-required
# FIXNA_CORS_ALLOWED_ORIGINS=https://consulting.fixna.in
# SPRING_DATASOURCE_URL=postgresql://consulting_user:${POSTGRES_PASSWORD}@fixnainfra-postgresadmin-qfasaa:5432/consulting_db

# ── LocalBoost API ──────────────────────────────────────────────────────────
# Local development
# SPRING_PROFILES_ACTIVE=dev
# POSTGRES_PASSWORD=dev-password
# FIXNA_JWT_SECRET=dev-jwt-secret
# FIXNA_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# SPRING_DATASOURCE_URL=postgresql://localboost_user:${POSTGRES_PASSWORD}@localhost:5432/localboost_db

# Production
# SPRING_PROFILES_ACTIVE=prod
# POSTGRES_PASSWORD=prod-localboost-db-password
# FIXNA_JWT_SECRET=prod-jwt-secret-required
# FIXNA_CORS_ALLOWED_ORIGINS=https://localboost.fixna.in
# FIXNA_AI_PROVIDER=mock
# FIXNA_PLATFORM_MODE=mock
# FIXNA_BILLING_DEFAULT_PLAN=STARTER
# REDIS_URL=redis://localhost:6379
# SPRING_DATASOURCE_URL=postgresql://localboost_user:${POSTGRES_PASSWORD}@fixnainfra-postgresadmin-qfasaa:5432/localboost_db

# ── Observability ────────────────────────────────────────────────────────────
# Local development
# OTEL_EXPORTER_OTLP_ENABLED=true
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318/v1/traces

# Production
# OTEL_EXPORTER_OTLP_ENABLED=false
# OTEL_EXPORTER_OTLP_ENDPOINT=https://otel.collector.fixna.in

# ── Common security settings ─────────────────────────────────────────────────
# In production, FIXNA_JWT_SECRET MUST be set with minimum 32 bytes
# In development, fallback is non-sensitive dev placeholder

# ── Required production environment variables ──────────────────────────────
# SPRING_PROFILES_ACTIVE=prod
# POSTGRES_PASSWORD
# FIXNA_JWT_SECRET
# FIXNA_CORS_ALLOWED_ORIGINS
# SPRING_DATASOURCE_URL
