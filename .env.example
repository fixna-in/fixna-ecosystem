# Fixna Ecosystem — environment template
# Copy per-product sections to service .env or app .env.local files. Never commit secrets.

# ── Shared local infrastructure (docker compose up -d) ───────────────────────
# Consulting Postgres: localhost:5433 / consulting
# LocalBoost Postgres:  localhost:5432 / fixna
# Redis:                localhost:6379

# ── Consulting API (port 8081) ──────────────────────────────────────────────
# SPRING_PROFILES_ACTIVE=local
# SERVER_PORT=8081
# SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5433/consulting
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=change-me
# FIXNA_JWT_SECRET=dev-only-secret-change-me-in-production-32bytes-minimum!!
# FIXNA_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# FIXNA_APP_ENV=local
# FIXNA_FILE_STORAGE_PATH=./storage

# Consulting Web → apps/consulting-web/.env.local
# NEXT_PUBLIC_API_BASE_URL=http://localhost:8081/api
# NEXT_PUBLIC_APP_ENV=local

# ── LocalBoost API (port 8080) ───────────────────────────────────────────────
# SPRING_PROFILES_ACTIVE=local
# SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/fixna
# POSTGRES_USER=fixna
# POSTGRES_PASSWORD=change-me
# FIXNA_JWT_SECRET=dev-only-secret-change-me-in-production-32bytes-minimum!!
# FIXNA_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# FIXNA_APP_ENV=local
# FIXNA_AI_PROVIDER=mock
# FIXNA_PLATFORM_MODE=mock
# FIXNA_BILLING_DEFAULT_PLAN=STARTER
# REDIS_URL=redis://localhost:6379

# LocalBoost Web → apps/localboost-web/.env.local
# NEXT_PUBLIC_API_BASE_URL=http://localhost:8080/api
# NEXT_PUBLIC_APP_ENV=local

# ── Observability ────────────────────────────────────────────────────────────
OTEL_EXPORTER_OTLP_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317

# Production — set per product on Render/Vercel (never share secrets across products)
# SPRING_PROFILES_ACTIVE=prod
# FIXNA_HSTS_ENABLED=true
