{
  "info": {
    "name": "Fixna Ecosystem API",
    "description": "Postman Collection for Fixna Ecosystem APIs (Consulting, LocalBoost, Hospitality, Website Audit, Invoice Assistant).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:80", "type": "string" },
    { "key": "bearerToken", "value": "YOUR_JWT_TOKEN", "type": "string" }
  ],
  "item": [
    {
      "name": "Consulting API",
      "item": [
        {
          "name": "Health Check",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/v1/health/ready" }
        },
        {
          "name": "List Clients",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{bearerToken}}" }],
            "url": "{{baseUrl}}/api/v1/clients"
          }
        }
      ]
    },
    {
      "name": "LocalBoost API",
      "item": [
        {
          "name": "Health Check",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/v1/health/readiness" }
        },
        {
          "name": "List Campaigns",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{bearerToken}}" }],
            "url": "{{baseUrl}}/api/v1/campaigns"
          }
        }
      ]
    },
    {
      "name": "Hospitality API",
      "item": [
        {
          "name": "Health Check",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/v1/health/readiness" }
        }
      ]
    },
    {
      "name": "Website Audit API",
      "item": [
        {
          "name": "Health Check",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/v1/health" }
        },
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"fixnainfo@gmail.com\",\n  \"password\": \"password\"\n}" },
            "url": "{{baseUrl}}/api/v1/auth/login"
          }
        },
        {
          "name": "Run Audit",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{bearerToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"url\": \"https://fixna.in\"\n}" },
            "url": "{{baseUrl}}/api/v1/website-audits"
          }
        }
      ]
    },
    {
      "name": "Invoice Assistant API",
      "item": [
        {
          "name": "Health Check",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/v1/health" }
        }
      ]
    }
  ]
}