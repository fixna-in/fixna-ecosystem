# ==============================================================================
# LOCALBOOST API — ECOSYSTEM CONFIGURATION PLACEHOLDER
# Contains local, dev, and production configurations in one reference file.
# ==============================================================================

# ── 1. COMMON / SERVER ────────────────────────────────────────────────────────
SERVER_PORT=80
FIXNA_AI_PROVIDER=mock
FIXNA_PLATFORM_MODE=mock

# ── 2. LOCAL ENVIRONMENT (Profile: local) ───────────────────────────────────
# SPRING_PROFILES_ACTIVE=local
# SERVER_PORT=8080
# FIXNA_APP_ENV=local
# SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/localboost_db
# POSTGRES_USER=localboost_user
# POSTGRES_PASSWORD=change-me
# FIXNA_JWT_SECRET=local-dev-only-jwt-secret-not-for-production-use-min-32-bytes!!
# FIXNA_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# REDIS_URL=redis://localhost:6379
# FIXNA_BILLING_DEFAULT_PLAN=FREE

# ── 3. DEVELOPMENT ENVIRONMENT (Profile: dev) ────────────────────────────────
# SPRING_PROFILES_ACTIVE=dev
# FIXNA_APP_ENV=dev
# SPRING_DATASOURCE_URL=jdbc:postgresql://fixnainfra-postgresadmin-qfasaa:5432/localboost_db
# POSTGRES_USER=localboost_user
# POSTGRES_PASSWORD=                        # ← set via environment variable
# FIXNA_JWT_SECRET=                         # ← set via environment variable
# FIXNA_CORS_ALLOWED_ORIGINS=https://dev-localboost.fixna.in
# FIXNA_BILLING_DEFAULT_PLAN=FREE
# REDIS_URL=

# ── 4. PRODUCTION ENVIRONMENT (Profile: prod) ────────────────────────────────
# SPRING_PROFILES_ACTIVE=prod
# FIXNA_APP_ENV=prod
# SPRING_DATASOURCE_URL=jdbc:postgresql://fixnainfra-postgresadmin-qfasaa:5432/localboost_db
# POSTGRES_USER=localboost_user
# POSTGRES_PASSWORD=                        # ← REQUIRED: set via Dokploy secret
# FIXNA_JWT_SECRET=                         # ← REQUIRED: min 32 bytes, set via Dokploy secret
# FIXNA_CORS_ALLOWED_ORIGINS=https://localboost.fixna.in
# FIXNA_BILLING_DEFAULT_PLAN=STARTER
# REDIS_URL=                                # ← set in Dokploy when Redis deployed
# DB_POOL_MAX=50
# DB_POOL_MIN=10
# DB_CONN_TIMEOUT_MS=2000
# FIXNA_RATE_LIMIT_PER_IP_PER_MINUTE=100
